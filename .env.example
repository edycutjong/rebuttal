# ── Nansen ───────────────────────────────────────────────────
# Get from: https://app.nansen.ai/api  (the only required configuration; 10–15 credits per rebuttal, 0 on a cache hit)
NANSEN_API_KEY=nsn_your-key-here

# ── Optional: the LLM (Groq, OpenAI-compatible). Without it the rules extractor and the template prose run; the verdict is the same.
# GROQ_API_KEY=gsk_…            or  GROQ_API_KEYS=gsk_a,gsk_b   (rotated on 429 / restricted)

# ── Optional ─────────────────────────────────────────────────
# Absolute origin used for Open Graph / Twitter image URLs (defaults to the Vercel alias)
# SITE_URL=https://rebuttal-edycutjong.vercel.app
# Spend guard on the public routes (defaults shown; see apps/web/lib/guard.ts)
GUARD_IP_PER_MIN=10
GUARD_DAILY_CREDITS=2000
GUARD_AGENT_IP_PER_DAY=2
GUARD_AGENT_PER_DAY=4
